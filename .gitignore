# .tools/          项目本地 Go 工具链与缓存（由 build.ps1 下载/生成）
.tools/
# 构建产物
dist/
# 临时文件（调研、抓包、测试素材）
.tmp/
*.zip
# 测试与运行期数据
run/
*.dltask
*.dltask.tmp
*.part

# 下载目录：含用户实际下载内容、隐私文件与控制面令牌，绝不入库
downloads/
download/
*.bolt.db
*.torrent
control.token
control.endpoint
# 编辑器/系统
.codexh/
.vscode/
.idea/
*.swp
Thumbs.db
desktop.ini

# 构建中生成的 Windows 资源与包目录
cmd/*/*.syso
dist/package/

# 本地生成的二进制与发布包
*.exe
p2pdl-*-win-*.zip
release/
